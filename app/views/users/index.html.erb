<h1>All users</h1>

<%= will_paginate %>

<ul>
  <% @users.each do |user| %>
    <li>
      <%= link_to user.name, user %>
      <% if current_user.admin? && current_user != user %>
        | <%= link_to "delete", user, data: { turbo_method: :delete, turbo_confirm: "You sure?" } %>
      <% end %>
    </li>
  <% end %>
</ul>

<%= will_paginate %>