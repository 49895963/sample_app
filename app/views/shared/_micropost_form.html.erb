<%= form_with(model: @micropost) do |f| %>
  <% if @micropost.errors.any? %>
    <div>
      <p><%= pluralize(@micropost.errors.count, "error") %> prohibited this micropost from being saved:</p>
      <ul>
        <% @micropost.errors.full_messages.each do |msg| %>
